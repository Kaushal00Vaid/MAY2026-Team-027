DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/societysync

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_USE_A_STRONG_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Twilio SMS (for Phone+OTP login)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# App
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
MEDIA_ROOT=./media
HELPDESK_MAX_UPLOAD_BYTES=5242880

# Resident Helpdesk AI assistant (keep this server-side; never use a VITE_ prefix)
AIPIPE_API_KEY=
AIPIPE_BASE_URL=https://aipipe.org/openrouter/v1
AIPIPE_MODEL=openai/gpt-4.1-nano
AIPIPE_TIMEOUT_SECONDS=20

# Scheduled worker (start separately with: python scheduler.py)
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_RUN_ON_STARTUP=true
SCHEDULER_MAX_ATTEMPTS=3
SCHEDULER_RETRY_DELAY_SECONDS=1
SCHEDULER_MISFIRE_GRACE_SECONDS=300
SCHEDULER_FANOUT_INTERVAL_SECONDS=60
SCHEDULER_EXPIRY_INTERVAL_SECONDS=60
SCHEDULER_BOOKING_INTERVAL_SECONDS=60
SCHEDULER_LATE_FEE_PAISE=50000

# Google OAuth (set these in Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
