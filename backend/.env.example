DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/societysync

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_USE_A_STRONG_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Twilio SMS (for Phone+OTP login)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# App
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
MEDIA_ROOT=./media
HELPDESK_MAX_UPLOAD_BYTES=5242880
