    FLATS {
        bigint flat_id PK
        string block
        smallint floor
        string flat_number
        enum residential_status
    }
    USERS {
        bigint user_id PK
        string full_name
        citext email
        string phone_number
        bigint flat_id FK
    }
    COMPLAINTS {
        bigint complaint_id PK
        bigint raised_by FK
        enum category
        enum status
        bigint linked_task_id FK
    }
    MAINTENANCE_TASKS {
        bigint task_id PK
        enum category
        bigint assigned_to FK
        enum status
        timestamptz sla_due_at
    }
    INVOICES {
        bigint invoice_id PK
        bigint flat_id FK
        enum purpose
        numeric base_amount
        enum status
    }
    PAYMENTS {
        bigint payment_id PK
        bigint invoice_id FK
        enum gateway
        enum status
    }
    AMENITY_BOOKINGS {
        uuid booking_id PK
        smallint amenity_id FK
        bigint flat_id FK
        timestamptz slot_start
        timestamptz slot_end
    }
